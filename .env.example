# PostgreSQL
DATABASE_URL=postgres://postgres:root@localhost:5432/kalsite

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback

# API (Hono)
NODE_ENV=development
API_HOST=localhost
API_PORT=5000
WEB_URL=http://localhost:3000

# Session / Security
SESSION_SECRET=replace-with-a-random-32-char-secret
# Shared server-to-server secret (must match API_SECRET_KEY in kalsite-frontend)
API_SECRET_KEY=replace-with-a-random-32-char-api-key
# Comma-separated Discord user IDs (or dev:username in dev mode) promoted to super-administrator on login
SUPER_ADMIN_DISCORD_IDS=
# Set to true only in local development to allow quick username login without Discord credentials
ALLOW_DEV_LOGIN=true

# System announcer name in match logs
SYSTEM_NAME=ZOOT
