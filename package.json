{
  "name": "kalsite-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target=bun",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/database/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun src/database/seeders/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2",
    "pg": "^8.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.3"
  }
}
